    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 h-screen flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-xl p-8 max-w-md w-full text-center">
        <div class="w-14 h-14 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </div>

        <?php if ($done): ?>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Data Berhasil Direset</h1>
        <p class="text-sm text-slate-500 mb-6">Semua data transaksi, menu, inventaris, meja, dan promo sudah dihapus. Data pengguna dan pengaturan tetap aman.</p>
        <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-700 font-medium mb-6">✅ Semua data operasional berhasil dibersihkan.</div>
        <a href="modules/kasir/index.php" class="inline-block px-6 py-2.5 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors">Mulai dari Awal</a>
        <?php elseif ($error): ?>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Gagal</h1>
        <p class="text-sm text-red-500 mb-6"><?= htmlspecialchars($error) ?></p>
        <a href="reset_data.php" class="inline-block px-6 py-2.5 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors">Coba Lagi</a>
        <?php else: ?>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Reset Data Aplikasi</h1>
        <p class="text-sm text-slate-500 mb-4">Tindakan ini akan menghapus:</p>
        <ul class="text-left text-sm text-slate-600 space-y-1 mb-6">
            <li class="flex items-center gap-2">• Semua transaksi penjualan</li>
            <li class="flex items-center gap-2">• Semua sesi shift kasir</li>
            <li class="flex items-center gap-2">• Semua menu & resep</li>
            <li class="flex items-center gap-2">• Semua bahan baku</li>
            <li class="flex items-center gap-2">• Semua meja & promo</li>
            <li class="flex items-center gap-2 border-t border-dashed border-slate-200 pt-2 mt-2"><span class="font-bold text-green-600">✓</span> Data pengguna tetap aman</li>
            <li class="flex items-center gap-2"><span class="font-bold text-green-600">✓</span> Pengaturan toko tetap aman</li>
            <li class="flex items-center gap-2"><span class="font-bold text-green-600">✓</span> Kategori menu tetap aman</li>
        </ul>
        <form method="POST" onsubmit="return confirm('Yakin ingin menghapus semua data? Tindakan ini tidak bisa dibatalkan.')">
            <?= csrfField() ?>
            <button type="submit" class="w-full px-6 py-2.5 bg-red-600 text-white font-bold rounded-lg hover:bg-red-700 transition-colors">Hapus Semua Data</button>
        </form>
        <a href="modules/admin/dashboard.php" class="inline-block mt-3 text-sm text-slate-400 hover:text-slate-600">Batal</a>
        <?php endif; ?>
    </div>
</body>
</html>
