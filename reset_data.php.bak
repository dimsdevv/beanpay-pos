<?php
/**
 * Checkpoint POS — Reset Data
 * Hapus seluruh data transaksi dan konten lama.
 * Tetap pertahankan: users, pengaturan, kategori.
 * Jalankan via browser: hapus file ini setelah selesai.
 */
require_once __DIR__ . '/config/database.php';
require_once __DIR__ . '/includes/auth.php';

requireRole(['admin']);

$error = '';
$done = false;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $pdo->beginTransaction();
        $pdo->exec("DELETE FROM pembayaran");
        $pdo->exec("DELETE FROM detail_pesanan");
        $pdo->exec("DELETE FROM pesanan");
        $pdo->exec("DELETE FROM sesi_kasir");
        $pdo->exec("DELETE FROM resep_menu");
        $pdo->exec("DELETE FROM menu");
        $pdo->exec("DELETE FROM bahan_baku");
        $pdo->exec("DELETE FROM meja");
        $pdo->exec("DELETE FROM promo");
        $pdo->exec("DELETE FROM audit_trail");
        $pdo->commit();

        // ALTER di luar transaksi (MySQL implicit commit)
        $pdo->exec("ALTER TABLE pembayaran AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE detail_pesanan AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE pesanan AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE sesi_kasir AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE resep_menu AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE menu AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE bahan_baku AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE meja AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE promo AUTO_INCREMENT = 1");
        $pdo->exec("ALTER TABLE audit_trail AUTO_INCREMENT = 1");

        $done = true;
    } catch (Exception $e) {
        if ($pdo->inTransaction()) {
            $pdo->rollBack();
        }
        $error = $e->getMessage();
    }
}
?>
